# Build environment for the Linux release of the editor.
# Ubuntu 24.04 sets the oldest supported glibc (2.39) and GTK (4.14).
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-gi python3-gi-cairo gir1.2-gtk-4.0 libgtk-4-1 libgtk-4-bin \
        gcc g++ patchelf ccache file binutils zstd unzip ca-certificates wget desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*
# Nuitka compiles the Python sources to C; no bytecode ships in the binaries.
RUN python3 -m venv --system-site-packages /opt/nuitka \
    && /opt/nuitka/bin/pip install --no-cache-dir nuitka==2.7.16 zstandard==0.23.0 ordered-set==4.1.0
